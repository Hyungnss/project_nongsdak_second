# 이 파일을 복사해 `.env` 로 만들고 값을 채운다. `.env` 는 커밋하지 않는다.
#   복사:  Copy-Item .env.example .env

# KAMIS OpenAPI — 고객센터 > Open-API > 이용신청 에서 발급받는다
KAMIS_CERT_KEY=
# KAMIS_CERT_ID 는 로그인 아이디가 아니라 KAMIS 마이페이지에 나오는 ID 다.
KAMIS_CERT_ID=

# Oracle — 실습 환경과 같다면 지워도 된다 (config.py 의 기본값이 쓰인다)
ORACLE_USER=kdt_admin
ORACLE_PASSWORD=1234
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=xe

# Instant Client 압축을 푼 폴더. 사람마다 다르다.
# oci.dll 이 바로 들어 있는 안쪽 폴더(instantclient_23_26)까지 적는다.
ORACLE_CLIENT_DIR=C:\instantclient-basic-windows.x64-23.26.3.0.0\instantclient_23_26

# 슬랙 알림 (선택) — 수집 완료·실패를 받을 Incoming Webhook URL.
# 슬랙 api.slack.com/apps 에서 앱 생성 > Incoming Webhooks > 채널 선택 후 발급한다.
# 비워두면 알림을 보내지 않는다.
SLACK_WEBHOOK_URL=

# PostgreSQL (v2) — docker compose 의 db 서비스가 이 값으로 만들어진다.
# 처음 docker compose up 하기 전에 비밀번호를 정해 둔다 (나중에 바꾸면 볼륨을 새로 만들어야 한다).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nongsdak
DB_USER=nongsdak
DB_PASSWORD=
