# 이 파일을 복사해 `.env` 로 만들고 값을 채운다. `.env` 는 커밋하지 않는다.
#   복사:  Copy-Item .env.example .env
# config.py 와 docker compose 가 둘 다 이 파일을 읽는다.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# docker compose 의 db 서비스가 이 값으로 만들어진다.
# 처음 `docker compose up -d db` 하기 전에 비밀번호를 정해 둔다
# (나중에 바꾸면 볼륨을 새로 만들어야 한다 — docker compose down -v).
# DB_HOST 는 localhost 대신 127.0.0.1 로 둔다 (Windows 는 localhost 를 IPv6 로 먼저 시도해 몇 초씩 멈춘다).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nongsdak
DB_USER=nongsdak
DB_PASSWORD=

# ── KAMIS OpenAPI ───────────────────────────────────────────────────────────
# 고객센터 > Open-API > 이용신청 에서 발급받는다
KAMIS_CERT_KEY=
# KAMIS_CERT_ID 는 로그인 아이디가 아니라 KAMIS 마이페이지에 나오는 ID 다.
KAMIS_CERT_ID=

# ── 슬랙 알림 (선택) ────────────────────────────────────────────────────────
# 수집 완료·실패를 받을 Incoming Webhook URL.
# 슬랙 api.slack.com/apps 에서 앱 생성 > Incoming Webhooks > 채널 선택 후 발급한다.
# 비워두면 알림을 보내지 않는다.
SLACK_WEBHOOK_URL=

# ── Oracle (v1) — Oracle 에서 데이터를 옮겨 올 때만 ─────────────────────────
# database/migrate_from_oracle.py 만 쓴다. 새로 시작하는 환경이면 지워도 된다.
# Oracle 11g 라 Instant Client 가 필요하다. oci.dll 이 바로 들어 있는 안쪽 폴더까지 적는다.
# ORACLE_USER=kdt_admin
# ORACLE_PASSWORD=
# ORACLE_HOST=localhost
# ORACLE_PORT=1521
# ORACLE_SERVICE=xe
# ORACLE_CLIENT_DIR=C:\instantclient-basic-windows.x64-23.26.3.0.0\instantclient_23_26
