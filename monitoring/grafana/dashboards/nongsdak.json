      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"web\"}[5m]))",
          "legendFormat": "",
          "range": true,
          "instant": false
